<script src="../site.js"></script>
<script>
/* The exporter flattened Figma's cup1 / cup2 into two sibling copies. Find them by
   walking up from the "font 2" artwork (it appears once in each) to the first level
   where their ancestor chains diverge, then run the Figma 6s sequence on the pair. */
(function () {
  var marks = [].slice.call(document.querySelectorAll('img[alt="font 2"]'));
  if (marks.length < 2) return;
  function chain(el) { var a = []; while (el) { a.unshift(el); el = el.parentElement; } return a; }
  var A = chain(marks[0]), B = chain(marks[1]), i = 0;
  while (i < A.length && i < B.length && A[i] === B[i]) i++;
  var g1 = A[i], g2 = B[i];
  if (!g1 || !g2) return;
  if (g1.offsetLeft > g2.offsetLeft) { var t = g1; g1 = g2; g2 = t; }
  g1.classList.add('gg-cup1');
  g2.classList.add('gg-cup2');
})();
</script>
